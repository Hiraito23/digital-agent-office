# Copy to .env and fill in. Never commit .env.
# Key the office uses to call the Hermes API server (random, at least 32 characters).
API_SERVER_KEY=
# Hermes dashboard login (http://127.0.0.1:9119); also used by the agent panel to edit SOUL.md.
DASH_USER=admin
DASH_PASS=
# Folder berisi proyek yang boleh dikerjakan agen (dibaca + ditulis), mis. D:/Coding.
# Kosong = folder ./projects di repo ini.
PROJECTS_DIR=
# Nama kantor yang tampil di header, judul tab browser, dan papan neon di dinding. Kosong = Agentic Digital Office.
OFFICE_NAME=
